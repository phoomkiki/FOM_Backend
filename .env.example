# Supabase Project Settings -> API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Use a server-side secret key (new format) or legacy service_role key. Never expose it in frontend code.
SUPABASE_SECRET_KEY=replace_with_server_side_secret_key

# LINE MINI App / LINE Developers
LINE_CHANNEL_ID=replace_with_line_mini_app_channel_id

# FOM application JWT: generate a random value of at least 32 characters
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional: add when the frontend has a real URL. Local dev origins are allowed by default.
FRONTEND_URL=
APP_ENV=development

# Optional: only for direct SQLAlchemy/Alembic maintenance, not runtime Data API requests.
# DATABASE_URL=postgresql+psycopg://...
